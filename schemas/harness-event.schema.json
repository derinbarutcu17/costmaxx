{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HarnessEvent",
  "type": "object",
  "required": ["event_id", "timestamp", "harness", "session_id", "event_type"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time"},
    "harness": {"type": "string"},
    "harness_version": {"type": "string"},
    "adapter_version": {"type": "string"},
    "session_id": {"type": "string"},
    "repository": {"type": "string"},
    "event_type": {"type": "string", "enum": ["session_start", "user_prompt_submit", "pre_tool_use", "post_tool_use", "pre_compact", "post_compact", "stop", "session_end"]},
    "tool_name": {"type": "string"},
    "tool_input": {"type": "object"},
    "tool_output": {"type": "string"},
    "execution_metadata": {"type": "object", "additionalProperties": {"type": "string"}},
    "capability_flags": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
